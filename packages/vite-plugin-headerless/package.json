{
  "name": "vite-plugin-headerless",
  "version": "0.1.4",
  "description": "Vite plugin that strips format-defining header fields from binary assets at build time",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "assets",
    "binary",
    "protection",
    "datamining",
    "capacitor",
    "electron"
  ],
  "author": "firejune",
  "license": "MIT",
  "dependencies": {
    "headerless": "^0.2.0",
    "tinyglobby": "^0.2.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "rollup": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blosharper/headerless.git",
    "directory": "packages/vite-plugin-headerless"
  },
  "bugs": {
    "url": "https://github.com/Blosharper/headerless/issues"
  },
  "homepage": "https://github.com/Blosharper/headerless#readme"
}
